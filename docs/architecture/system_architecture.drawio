<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="system_arch" name="System Architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Figure 2.1: Preliminary System Architecture&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #64748B;&quot;&gt;Co-Optimization of KV-Cache Management: Priority Scoring, Selective Quantization, and CPU Compute Delegation&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="800" height="50" as="geometry" /></mxCell><mxCell id="3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;arcSize=4;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="1100" height="210" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;HOST SYSTEM LAYER (Host CPU &amp;amp; Main System Memory)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#1E293B;fontSize=13;" vertex="1" parent="3"><mxGeometry x="20" y="10" width="450" height="30" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;Host DRAM Capacity: 16–32 GB DDR4/DDR5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="3"><mxGeometry x="820" y="12" width="260" height="24" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;Host DRAM Tiered Cache Pool&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: #334155;&quot;&gt;&#10;• &lt;b&gt;Offloaded INT4 KV Tensors:&lt;/b&gt; 75% memory footprint reduction&lt;br/&gt;&#10;• &lt;b&gt;Swapped Inactive Sessions:&lt;/b&gt; Multi-turn conversational history&lt;br/&gt;&#10;• &lt;b&gt;Zero-Copy Pinned Allocation:&lt;/b&gt; Enables async high-speed DMA&lt;br/&gt;&#10;• &lt;b&gt;Dynamic Eviction Buffer:&lt;/b&gt; Scales context to 10k+ tokens&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=top;spacingTop=8;arcSize=5;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="450" height="140" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;CPU Compute Delegation Engine (Decompression)&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: #334155;&quot;&gt;&#10;• &lt;b&gt;Harvests Idle CPU Cycles:&lt;/b&gt; Active during GPU autoregression&lt;br/&gt;&#10;• &lt;b&gt;Vectorized SIMD / AVX-512:&lt;/b&gt; Dequantizes INT4 -&gt; FP16 in DRAM&lt;br/&gt;&#10;• &lt;b&gt;Zero GPU Core Stall:&lt;/b&gt; Decompression completed before transfer&lt;br/&gt;&#10;• &lt;b&gt;Asynchronous Worker Pool:&lt;/b&gt; Multi-threaded parallel execution&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=top;spacingTop=8;arcSize=5;" vertex="1" parent="1"><mxGeometry x="670" y="140" width="450" height="140" as="geometry" /></mxCell><mxCell id="8" value="Decompress INT4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=10;fontColor=#475569;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="9" value="&lt;b&gt;PCIe Gen3 / Gen4 Motherboard Interconnect&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px; color: #2563EB;&quot;&gt;Asynchronous DMA Pipeline: Overlaps transfers with GPU computation&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 9px; color: #3730A3;&quot;&gt;&lt;b&gt;Bus Bandwidth: 16–31.5 GB/s (x8 / x16 lanes)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;dashed=1;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="325" width="500" height="60" as="geometry" /></mxCell><mxCell id="10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.5;verticalAlign=top;arcSize=4;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="1100" height="220" as="geometry" /></mxCell><mxCell id="11" value="&lt;b&gt;TARGET ACCELERATOR LAYER (Consumer GPU: NVIDIA RTX 4060 8GB / 16GB)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#14532D;fontSize=13;" vertex="1" parent="10"><mxGeometry x="20" y="10" width="520" height="30" as="geometry" /></mxCell><mxCell id="12" value="&lt;b&gt;On-Board GDDR6 Bandwidth: ~272 GB/s&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#BBF7D0;fontColor=#15803D;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="10"><mxGeometry x="820" y="12" width="260" height="24" as="geometry" /></mxCell><mxCell id="13" value="&lt;b&gt;Attention-Based Priority Engine &amp;amp; Routing Core&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: #1E293B;&quot;&gt;&#10;• &lt;b&gt;Dynamic Priority Scorer:&lt;/b&gt; Score = Attention Weight x Recency&lt;br/&gt;&#10;• &lt;b&gt;PagedBlock Allocator:&lt;/b&gt; Eliminates VRAM fragmentation&lt;br/&gt;&#10;• &lt;b&gt;Selective Quantization:&lt;/b&gt; High-Priority -&gt; FP16; Low -&gt; INT4&lt;br/&gt;&#10;• &lt;b&gt;Offload Router:&lt;/b&gt; Identifies cold blocks for CPU DRAM transfer&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1;align=center;verticalAlign=top;spacingTop=8;arcSize=5;" vertex="1" parent="1"><mxGeometry x="80" y="460" width="450" height="150" as="geometry" /></mxCell><mxCell id="14" value="&lt;b&gt;Active High-Priority KV Cache &amp;amp; Execution Core (VRAM)&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: #1E293B;&quot;&gt;&#10;• &lt;b&gt;Pinned Attention Sinks:&lt;/b&gt; Initial 1–4 tokens kept in FP16&lt;br/&gt;&#10;• &lt;b&gt;Heavy-Hitter (H2) Tokens:&lt;/b&gt; Top 5–20% critical context in FP16&lt;br/&gt;&#10;• &lt;b&gt;Full Reasoning Fidelity:&lt;/b&gt; Prevents needle loss &amp;amp; context blindness&lt;br/&gt;&#10;• &lt;b&gt;FlashAttention-2 / Decode:&lt;/b&gt; Generates next output token&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1;align=center;verticalAlign=top;spacingTop=8;arcSize=5;" vertex="1" parent="1"><mxGeometry x="670" y="460" width="450" height="150" as="geometry" /></mxCell><mxCell id="15" value="Retain FP16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803D;strokeWidth=2;fontSize=10;fontColor=#15803D;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="16" value="1. Offload INT4 (Saves 75% VRAM)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2.5;fontColor=#B91C1C;fontSize=10;labelBackgroundColor=#FEF2F2;labelBorderColor=#FECACA;;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0" edge="1" parent="1" source="13" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="2. Stream FP16 (Prefetched, Zero Stall)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2.5;fontColor=#1D4ED8;fontSize=10;labelBackgroundColor=#EFF6FF;labelBorderColor=#BFDBFE;;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="7" target="14"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>